# Copy to .env and fill in an API key:  cp .env.example .env
# Never commit .env.

# ---------- Host ports (change if they clash with something on your machine) ----------
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------- Database ----------
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind
# Used when running the backend/tests directly on the host (make targets use Docker instead).
DATABASE_URL=postgresql+asyncpg://docmind:docmind@localhost:5433/docmind

# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Browser origin(s) allowed by CORS; must match the frontend URL.
CORS_ORIGINS=http://localhost:3000
# Browser-facing backend URL, baked into the frontend bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Uploads ----------
MAX_UPLOAD_MB=20

# ---------- RAG ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.45
HISTORY_MESSAGES=6

# ---------- LLM ----------
# anthropic | openai | fake (offline demo without an API key; answers are just quoted passages)
LLM_PROVIDER=anthropic
# Model names: Anthropic https://docs.anthropic.com/en/docs/about-claude/models/overview
#              OpenAI    https://platform.openai.com/docs/models
# e.g. claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-4-5 (for haiku: LLM_EFFORT= and LLM_FALLBACKS_ENABLED=false)
LLM_MODEL=claude-opus-5-5
# Anthropic only: low | medium | high | xhigh | max (blank = model default)
LLM_EFFORT=low
LLM_FALLBACKS_ENABLED=true
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Anthropic key: https://console.anthropic.com -> Settings -> API Keys (account needs credits: Settings -> Billing)
ANTHROPIC_API_KEY=
# OpenAI key: https://platform.openai.com -> API keys (needs billing set up)
OPENAI_API_KEY=

# ---------- Rate limits ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_LOGIN=5/minute
