digraph G {
  rankdir=TB; bgcolor="transparent"; pad=0.2; nodesep=0.35; ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#1b2433", fontname="Noto Sans", fontsize=11, margin="0.15,0.08"];
  edge [color="#5a6475", fontname="Noto Sans", fontsize=9, fontcolor="#5a6475"];
  browser [label="Browser\nNext.js 16 + React 19", fillcolor="#eef1f6"];
  subgraph cluster_api { label="FastAPI backend (Python 3.12, async)"; fontname="Noto Sans"; fontsize=10; style="rounded,dashed"; color="#1f3a8a";
    routes [label="Routes\nauth · documents · chat · health"];
    ing [label="Ingestion\n(BackgroundTask)"];
    rag [label="RAG service", fillcolor="#f7e27a"];
    emb [label="FastEmbed\nbge-small (384-d)"];
    llm [label="LLM wrapper\nAnthropic / OpenAI"];
  }
  pg [label="PostgreSQL 16\n+ pgvector (HNSW)", shape=cylinder, fillcolor="#eef1f6"];
  files [label="Upload volume\n<uuid>.pdf", shape=folder];
  cloud [label="Claude API", shape=box, style="rounded,dashed"];
  browser -> routes [label="REST + JWT"];
  browser -> routes [label="POST /api/chat\nSSE stream", style=bold, color="#1f3a8a"];
  routes -> ing; routes -> rag;
  ing -> emb; rag -> emb; ing -> pg; rag -> pg; ing -> files;
  rag -> llm; llm -> cloud [label="HTTPS"];
}
